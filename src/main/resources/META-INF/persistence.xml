<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="smartcity360PU" transaction-type="JTA">
        <jta-data-source>jdbc/smartcity360</jta-data-source>

        <class>lk.jiat.smartcity360.persistence.entity.AppUserEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.ZoneEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.EnergyMeterEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.MeterReadingEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.StaffMemberEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.ResidentEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.ComplaintEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.ComplaintTraceEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.StreetlightModelEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.StreetlightEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.SensorEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.SensorReadingEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.WasteBinEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.PolicyEntity</class>
        <class>lk.jiat.smartcity360.persistence.entity.PolicyLogEntity</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
